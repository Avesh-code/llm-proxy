# ─────────────────────────────────────────────────────────────────────────────
#  LLM Proxy — environment template
#  Copy this to .env, fill in real values, then `chmod 600 .env`.
#  .env itself is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin UI ─────────────────────────────────────────────────────────────────
# Guards http://<this-host>:4000/admin and its API. Anyone with this token can
# add/edit backends and teams and read every backend API key and team token.
#   generate one:  openssl rand -hex 24
ADMIN_TOKEN=

# The domain your teams actually use to reach this proxy. Set this once you
# have one — it's used verbatim in /whoami's curl examples, instead of
# guessing from request headers (which only works if a reverse proxy is
# correctly forwarding X-Forwarded-Proto/X-Forwarded-Host). No trailing slash.
# PUBLIC_BASE_URL=https://llm.company.com

# ── Everything below is a ONE-TIME MIGRATION SEED (optional) ────────────────
# Backends, teams, and Langfuse tracing settings are managed live at /admin
# and persisted to data/config.json — no restart needed, and that file is
# what the proxy actually reads after its first boot.
#
# With backends.yaml's examples left commented out (the default), the proxy
# just starts empty and everything gets added through /admin. Only fill in
# the vars below if you uncomment matching entries in backends.yaml and want
# them seeded automatically on next first-boot instead. (Re-seed from
# scratch at any time: delete data/config.json and restart.)

# Backend API keys — one var per backend.api_key_env in backends.yaml.
# OPENAI_API_KEY=sk-proj-REPLACE_ME
# VLLM_PROD_API_KEY=

# Langfuse (tracing) — would seed the initial per-team tracing keys for any
# teams uncommented below. Each team gets its own Langfuse project, set on
# that team's card at /admin.
# LANGFUSE_HOST=https://your-langfuse-host.example.com
# LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
# LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME

# Developer bearer tokens — one var per team.token_env in backends.yaml.
#   generate one:  openssl rand -hex 24
# TOKEN_TEAM_PLATFORM=
# TOKEN_TEAM_SEARCH=
# TOKEN_TEAM_ML=

# ── Proxy ────────────────────────────────────────────────────────────────────
# Path to the migration-seed topology file. Defaults to backends.yaml.
# CONFIG_PATH=backends.yaml
# Host-side port. The container always listens on 4000 internally.
PROXY_PORT=4000
# Max seconds to wait for the upstream to respond (long, for big inference).
PROXY_TIMEOUT=600
